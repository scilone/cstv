<?xml version="1.0" encoding="utf-8"?>
<!--
    Règles d'extraction (API 31+, android:dataExtractionRules).
    Mêmes exclusions que backup_rules.xml : les prefs chiffrées du
    CredentialsManager dépendent d'une clé Keystore non transférable.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secret_shared_prefs.xml" />
        <exclude domain="sharedpref" path="credentials_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secret_shared_prefs.xml" />
        <exclude domain="sharedpref" path="credentials_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
