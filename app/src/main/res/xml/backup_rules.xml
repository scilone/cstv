<?xml version="1.0" encoding="utf-8"?>
<!--
    Règles de backup (API <= 30, android:fullBackupContent).
    Les SharedPreferences chiffrées du CredentialsManager sont exclues :
    la MasterKey vit dans l'Android Keystore (matérielle, non sauvegardée),
    donc des prefs restaurées sur un autre appareil seraient indéchiffrables
    et feraient crasher l'app. Exclure évite aussi d'exfiltrer les
    identifiants Xtream dans les backups cloud/ADB.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secret_shared_prefs.xml" />
    <exclude domain="sharedpref" path="credentials_prefs.xml" />
</full-backup-content>
