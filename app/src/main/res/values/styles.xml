<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <!-- Parent AppCompat : requis par le dialogue de sélection d'appareil Cast
         (MediaRouteChooserDialog = AppCompatDialog) qui se construit avec le
         thème de l'Activity. Fullscreen + fond noir préservés. -->
    <style name="Theme.IptvXtream" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Thème du bouton Cast (MediaRouteButton). -->
    <style name="Theme.Cast" parent="Theme.AppCompat.DayNight.NoActionBar" />
</resources>
