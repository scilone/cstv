#!/usr/bin/env php
<?php

declare(strict_types=1);

use Cstv\Backend\Database\Connection;
use Cstv\Backend\Shared\Config;

require dirname(__DIR__) . '/vendor/autoload.php';

$config = Config::fromEnvironment();
if ($config->appEnv === 'production') {
    fwrite(STDERR, "Fixtures are disabled in production.\n");
    exit(1);
}

/** @var array{accounts: list<array<string, mixed>>, profiles: list<array<string, mixed>>, namespaces: list<array<string, mixed>>} $fixture */
$fixture = require dirname(__DIR__) . '/fixtures/demo.php';
$pdo = Connection::create($config);
$pdo->beginTransaction();

try {
    $pdo->exec('TRUNCATE TABLE auth_verify_attempts, profile_objects, profiles, otp_codes, accounts RESTART IDENTITY CASCADE');

    $insertAccount = $pdo->prepare(
        'INSERT INTO accounts (id, email, enabled, active_until, created_at, updated_at) '
        . "VALUES (:id, :email, :enabled, CASE WHEN :active THEN NOW() + INTERVAL '1 year' "
        . "ELSE NOW() - INTERVAL '1 day' END, NOW(), NOW())",
    );
    foreach ($fixture['accounts'] as $account) {
        $insertAccount->bindValue(':id', $account['id']);
        $insertAccount->bindValue(':email', $account['email']);
        $insertAccount->bindValue(':enabled', $account['enabled'], \PDO::PARAM_BOOL);
        $insertAccount->bindValue(':active', $account['active'], \PDO::PARAM_BOOL);
        $insertAccount->execute();
    }

    $insertProfile = $pdo->prepare(
        'INSERT INTO profiles (id, account_id, name, avatar_id, created_at, updated_at) '
        . 'VALUES (:id, :account_id, :name, :avatar_id, NOW(), NOW())',
    );
    foreach ($fixture['profiles'] as $profile) {
        $insertProfile->execute($profile);
    }

    $insertObject = $pdo->prepare(
        'INSERT INTO profile_objects '
        . '(profile_id, namespace, payload, etag, schema_version, compressed_size, created_at, updated_at) '
        . 'VALUES (:profile_id, :namespace, :payload, :etag, :schema_version, :compressed_size, NOW(), NOW())',
    );

    foreach ($fixture['namespaces'] as $snapshot) {
        $json = json_encode($snapshot['value'], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES);
        $payload = gzencode($json, 6);
        if ($payload === false) {
            throw new RuntimeException('Unable to gzip fixture payload.');
        }
        $etag = hash('sha256', $payload);

        $insertObject->bindValue(':profile_id', $snapshot['profile_id']);
        $insertObject->bindValue(':namespace', $snapshot['namespace']);
        $insertObject->bindValue(':payload', $payload, PDO::PARAM_LOB);
        $insertObject->bindValue(':etag', $etag);
        $insertObject->bindValue(':schema_version', $snapshot['schema_version'], PDO::PARAM_INT);
        $insertObject->bindValue(':compressed_size', strlen($payload), PDO::PARAM_INT);
        $insertObject->execute();
    }

    $pdo->commit();
} catch (Throwable $exception) {
    if ($pdo->inTransaction()) {
        $pdo->rollBack();
    }
    fwrite(STDERR, $exception->getMessage() . "\n");
    exit(1);
}

fwrite(STDOUT, <<<'OUTPUT'
Fixtures loaded.

Accounts:
  demo@cstv.local     11111111-1111-4111-8111-111111111101 (active)
  expired@cstv.local  11111111-1111-4111-8111-111111111102 (expired)
  disabled@cstv.local 11111111-1111-4111-8111-111111111103 (disabled)

Demo profiles:
  Nico   22222222-2222-4222-8222-222222222201
  Enfant 22222222-2222-4222-8222-222222222202

OUTPUT);
if ($config->otpTestCode !== null) {
    fwrite(STDOUT, sprintf("Non-production OTP test code: %s\n", $config->otpTestCode));
}
