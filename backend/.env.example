APP_ENV=dev
APP_DEBUG=0
HTTP_PORT=18080

POSTGRES_DB=cstv
POSTGRES_USER=cstv
POSTGRES_PASSWORD=cstv-dev-password
DB_HOST=postgres
DB_PORT=5432

JWT_SECRET=change-this-dev-jwt-secret-at-least-32-chars
OTP_HASH_SECRET=change-this-dev-otp-secret-at-least-32-chars
OTP_TEST_CODE=123456
OTP_FROM_EMAIL=
OTP_FROM_NAME=CSTV
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_EMAIL=5
OTP_REQUEST_LIMIT_IP=20
OTP_RATE_WINDOW_SECONDS=3600
OTP_VERIFY_LIMIT_IP=30
OTP_VERIFY_WINDOW_SECONDS=60

# Server-side only. Never add this token to the Android app or a committed file.
TMDB_API_TOKEN=

MAX_OBJECT_SIZE_BYTES=1048576
MAX_PROFILES_PER_ACCOUNT=10
MAX_NAMESPACES_PER_PROFILE=32
MAX_STORAGE_BYTES_PER_ACCOUNT=20971520
MAX_IPTV_CREDENTIALS_BYTES=4096
# Generate a unique local key with: openssl rand -base64 32
IPTV_CREDENTIALS_KEYS=dev:D8pQGfEoXb1hw8aqE5M7HcE0CtFs1DZwVzQpR3nqKWE=
IPTV_CREDENTIALS_KEY_ID=dev
